generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     Int       @id @default(autoincrement())
  name                   String
  email                  String    @unique
  password               String
  role                   String    @default("customer")
  reset_password_token   String?
  reset_password_expires DateTime?
  is_email_verified          Boolean   @default(false)
  verification_token         String?
  verification_token_expires DateTime?
  preferred_lang         String    @default("ar")

  cart                   Cart?
  favorites              Favorite[]
  reviews                Review[]
  orders                 Order[]
  refundRequests         RefundRequest[]
  payoutsCreated         Payout[]  @relation("PayoutCreatedBy")
  tickets                Ticket[]
  vendor                 Vendor?

  @@map("users")
}

model Book {
  id               Int     @id @default(autoincrement())
  title            Json
  isbn             String
  publisher_email  String
  description      Json
  publisher        String
  category         String
  category_id      Int?
  categoryRef      Category? @relation(fields: [category_id], references: [id], onDelete: Restrict)
  brand            String?
  attributes       Json?
  status           String  @default("published")
  cover_url        String?
  cover_key        String?
  price            Int     @default(0)
  stock            Int     @default(0)
  favorites_count  Int     @default(0)
  cart_adds_count  Int     @default(0)
  popularity_score Int     @default(0)
  rating_average   Float   @default(0)
  reviews_count    Int     @default(0)

  vendor_id        Int
  vendor           Vendor  @relation(fields: [vendor_id], references: [id], onDelete: Restrict)

  cartItems        CartItem[]
  favorites        Favorite[]
  reviews          Review[]
  orderItems       OrderItem[]
  variants         ProductVariant[]

  @@index([vendor_id])
  @@index([category_id])
  @@index([status])
  @@map("books")
}

model ProductVariant {
  id         Int      @id @default(autoincrement())
  product_id Int
  product    Book     @relation(fields: [product_id], references: [id], onDelete: Cascade)
  sku        String?
  barcode    String?
  options    Json     @default("{}")
  price      Int
  stock      Int      @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  cartItems  CartItem[]

  @@unique([product_id, sku])
  @@index([product_id])
  @@map("product_variants")
}

model Category {
  id         Int        @id @default(autoincrement())
  slug       String     @unique
  name       Json
  parent_id  Int?
  parent     Category?  @relation("CategoryTree", fields: [parent_id], references: [id], onDelete: Restrict)
  children   Category[] @relation("CategoryTree")
  products   Book[]
  created_at DateTime   @default(now())

  @@index([parent_id])
  @@map("categories")
}

model Vendor {
  id             Int      @id @default(autoincrement())
  owner_id       Int?     @unique
  owner          User?    @relation(fields: [owner_id], references: [id], onDelete: SetNull)
  store_name     String
  slug           String   @unique
  status         String   @default("pending")
  is_platform    Boolean  @default(false)
  commission_bps Int?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  books          Book[]
  vendorOrders   VendorOrder[]
  payouts        Payout[]

  @@map("vendors")
}

model PlatformSetting {
  key        String   @id
  value      Json
  updated_at DateTime @updatedAt

  @@map("platform_settings")
}

model Order {
  id                 Int         @id @default(autoincrement())
  user_id            Int
  user               User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  status             String      @default("pending")
  stripe_session_id  String?     @unique
  payment_intent_id  String?     @unique
  paid_at            DateTime?
  total_amount       Int
  currency           String      @default("egp")
  shipping_name      String?
  shipping_phone     String?
  shipping_address   String?
  shipping_city      String?
  shipping_notes     String?
  items              OrderItem[]
  vendorOrders       VendorOrder[]
  refundRequests     RefundRequest[]
  created_at         DateTime    @default(now())
  updated_at         DateTime    @updatedAt

  @@map("orders")
}

model VendorOrder {
  id                 Int        @id @default(autoincrement())
  order_id           Int
  order              Order      @relation(fields: [order_id], references: [id], onDelete: Cascade)
  vendor_id          Int
  vendor             Vendor     @relation(fields: [vendor_id], references: [id], onDelete: Restrict)
  fulfillment_status String     @default("pending")
  carrier            String?
  tracking_number    String?
  shipped_at         DateTime?
  delivered_at       DateTime?

  // Money snapshot, frozen when the order is paid so later commission-rate
  // changes never rewrite history. All amounts are in piastres.
  commission_bps     Int?
  gross_amount       Int?
  commission_amount  Int?
  net_amount         Int?

  payout_id          Int?
  payout             Payout?    @relation(fields: [payout_id], references: [id], onDelete: SetNull)

  created_at         DateTime   @default(now())
  updated_at         DateTime   @updatedAt

  items              OrderItem[]

  @@unique([order_id, vendor_id])
  @@index([vendor_id])
  @@index([payout_id])
  @@map("vendor_orders")
}

model Payout {
  id            Int           @id @default(autoincrement())
  vendor_id     Int
  vendor        Vendor        @relation(fields: [vendor_id], references: [id], onDelete: Restrict)
  amount        Int
  currency      String        @default("egp")
  reference     String?
  note          String?
  created_by_id Int?
  created_by    User?         @relation("PayoutCreatedBy", fields: [created_by_id], references: [id], onDelete: SetNull)
  created_at    DateTime      @default(now())

  vendorOrders  VendorOrder[]

  @@index([vendor_id])
  @@map("payouts")
}

model RefundRequest {
  id          Int       @id @default(autoincrement())
  order_id    Int
  order       Order     @relation(fields: [order_id], references: [id], onDelete: Cascade)
  user_id     Int
  user        User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  reason      String
  status      String    @default("pending")
  admin_note  String?
  created_at  DateTime  @default(now())
  reviewed_at DateTime?
  updated_at  DateTime  @updatedAt

  @@map("refund_requests")
}

model Ticket {
  id         Int       @id @default(autoincrement())
  user_id    Int
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  subject    String
  status     String    @default("opened")
  messages   TicketMessage[]
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  closed_at  DateTime?

  @@map("tickets")
}

model TicketMessage {
  id          Int      @id @default(autoincrement())
  ticket_id   Int
  ticket      Ticket   @relation(fields: [ticket_id], references: [id], onDelete: Cascade)
  sender_type String
  sender_id   Int?
  body        String
  created_at  DateTime @default(now())

  @@map("ticket_messages")
}

model OrderItem {
  id              Int          @id @default(autoincrement())
  order_id        Int
  order           Order        @relation(fields: [order_id], references: [id], onDelete: Cascade)
  book_id         Int
  book            Book         @relation(fields: [book_id], references: [id])
  vendor_order_id Int?
  vendorOrder     VendorOrder? @relation(fields: [vendor_order_id], references: [id], onDelete: SetNull)
  quantity        Int
  unit_price      Int

  @@index([vendor_order_id])
  @@map("order_items")
}

model Cart {
  id         Int        @id @default(autoincrement())
  user_id    Int        @unique
  user       User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  items      CartItem[]
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt

  @@map("carts")
}

model CartItem {
  id         Int             @id @default(autoincrement())
  cart_id    Int
  cart       Cart            @relation(fields: [cart_id], references: [id], onDelete: Cascade)
  book_id    Int
  book       Book            @relation(fields: [book_id], references: [id], onDelete: Cascade)
  variant_id Int?
  variant    ProductVariant? @relation(fields: [variant_id], references: [id], onDelete: Cascade)
  quantity   Int             @default(1)
  created_at DateTime        @default(now())

  @@unique([cart_id, book_id])
  @@unique([cart_id, variant_id])
  @@index([variant_id])
  @@map("cart_items")
}

model Favorite {
  id         Int      @id @default(autoincrement())
  user_id    Int
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  book_id    Int
  book       Book     @relation(fields: [book_id], references: [id], onDelete: Cascade)
  created_at DateTime @default(now())

  @@unique([user_id, book_id])
  @@map("favorites")
}

model Review {
  id         Int      @id @default(autoincrement())
  user_id    Int
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  book_id    Int
  book       Book     @relation(fields: [book_id], references: [id], onDelete: Cascade)
  rating     Int
  comment    String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([user_id, book_id])
  @@map("reviews")
}

model ContactMessage {
  id         Int      @id @default(autoincrement())
  name       String
  email      String
  subject    String
  message    String
  created_at DateTime @default(now())

  @@map("contact_messages")
}