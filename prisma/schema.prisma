generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     Int       @id @default(autoincrement())
  name                   String
  email                  String    @unique
  password               String
  role                   String    @default("customer")
  reset_password_token   String?
  reset_password_expires DateTime?

  @@map("users") 
}

model Book {
  id               Int     @id @default(autoincrement())
  title            String
  isbn             String
  publisher_email  String
  description      String
  publisher        String
  category         String
  cover_url        String?
  cover_key        String?

  @@map("books")
}